[Unit]
Description=Encrypted off-site backup for Donation Alerts
Wants=network-online.target
After=network-online.target donation-alerts-backup.service

[Service]
Type=oneshot
User=root
Group=root
EnvironmentFile=/etc/donation-alerts-remote-backup.env
ExecStart=/usr/bin/bash /opt/donation-alerts/scripts/remote_backup.sh
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadOnlyPaths=/opt/donation-alerts /var/backups/donation-alerts /etc/rclone/rclone.conf
ReadWritePaths=/run/lock
