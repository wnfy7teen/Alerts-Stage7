+def _asset_version() -> str:
+    """Короткий отпечаток стилей: при любой правке адрес меняется, и браузер не держит старую версию."""
+    h = hashlib.sha256()
+    for f in sorted((STATIC / "assets").glob("*.css")):
+        h.update(f.read_bytes())
