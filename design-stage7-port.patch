+/* Компоненты и раскладка. Мобильная вёрстка первая; точки: 360 (база), 768, 1024, 1440.
+   Язык оформления: плоские цвета бренда, толстые контуры, «твёрдые» смещённые тени. Цвета и размеры только из tokens.css */
+
+*, *::before, *::after { box-sizing: border-box; }
+html { -webkit-text-size-adjust: 100%; scroll-padding-top: var(--sp-5); }
+body { margin: 0; min-height: 100vh; background: var(--c-bg); color: var(--c-ink); font: 400 var(--fs-0) / var(--lh-body) var(--font-body); }
+h1, h2, h3 { font-family: var(--font-head); line-height: var(--lh-head); letter-spacing: -0.01em; margin: 0; text-wrap: balance; }
+p { margin: 0; }
+a { color: var(--c-link); }
+img, svg { max-width: 100%; }
+[hidden] { display: none !important; }
+.sr-only { position: absolute; width: 1px; height: 1px; padding: 0; margin: -1px; overflow: hidden; clip-path: inset(50%); white-space: nowrap; border: 0; }
+:focus-visible { outline: 3px solid var(--c-focus); outline-offset: 3px; border-radius: var(--r-s); }
+
+.skip { position: absolute; left: var(--sp-4); top: -4rem; z-index: 10; padding: var(--sp-3) var(--sp-4); border-radius: var(--r-m);
+  background: var(--c-action); color: var(--c-on-action); font-weight: 700; text-decoration: none; }
+.skip:focus { top: var(--sp-4); }
+
+/* ───── раскладка: сетка на 12 колонок ───── */
+.shell { max-width: 75rem; margin-inline: auto; padding: 0 var(--sp-4) var(--sp-8); }
+.layout { display: grid; grid-template-columns: repeat(12, minmax(0, 1fr)); gap: var(--sp-7) var(--sp-4); }
+.layout > * { grid-column: 1 / -1; min-width: 0; }
+@media (min-width: 48em) { .shell { padding-inline: var(--sp-6); } .layout > * { grid-column: 2 / 12; } }
+@media (min-width: 64em) {                       /* 1024: слева сцена и текст, справа форма, которая едет за страницей */
+  .layout { column-gap: var(--sp-7); align-items: start; }
+  .hero { grid-column: 1 / 8; grid-row: 1; }
+  .panel { grid-column: 8 / 13; grid-row: 1 / span 3; position: sticky; top: var(--sp-5); }
+  .steps { grid-column: 1 / 8; grid-row: 2; }
+  .faq { grid-column: 1 / 8; grid-row: 3; }
+}
+
+/* ───── верхняя панель ───── */
+.topbar { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: var(--sp-2) var(--sp-4); padding: var(--sp-4) 0 var(--sp-6); max-width: 75rem; margin-inline: auto; }
+.brand { display: inline-flex; align-items: center; gap: var(--sp-3); min-height: var(--tap); color: var(--c-ink); text-decoration: none; font: 800 1.0625rem var(--font-head); white-space: nowrap; }
+.brand .mark { flex: none; width: 2.5rem; height: 2.5rem; display: grid; place-items: center; border: 2px solid var(--c-outline); border-radius: 50%; background: var(--c-brand); }
+.brand .mark svg { width: 1.125rem; height: 1.125rem; fill: #FCFFFF; }
+.toplinks { list-style: none; margin: 0; padding: 0; display: flex; gap: var(--sp-2); }
+.toplinks a { display: inline-flex; align-items: center; min-height: var(--tap); padding: 0 var(--sp-4); border: 2px solid var(--c-outline); border-radius: var(--r-pill);
+  background: var(--c-surface); color: var(--c-ink); font-weight: 700; text-decoration: none; }
+.toplinks a:hover { background: var(--c-pink); }
+
+/* ───── шапка страницы ───── */
+.hero { container-type: inline-size; }
+.hero h1 { font-weight: 800; line-height: 0.98; letter-spacing: -0.03em; overflow-wrap: anywhere;
+  font-size: clamp(2.2rem, 9vw, 5.25rem); font-size: clamp(2.2rem, 11.5cqw, 5.25rem); }
+.hero h1.n-m { font-size: clamp(2rem, 8vw, 4.25rem); font-size: clamp(2rem, 8.5cqw, 4.25rem); }
+.hero h1.n-l { font-size: clamp(1.8rem, 6vw, 3.25rem); font-size: clamp(1.8rem, 6cqw, 3.25rem); }
+.hero h1 span { display: block; }
+.intro { margin-top: var(--sp-5); max-width: 34rem; font-size: var(--fs-1); line-height: 1.5; }
+.facts { list-style: none; padding: 0; margin: var(--sp-5) 0 0; display: flex; flex-wrap: wrap; gap: var(--sp-2) var(--sp-5); font-weight: 600; }
+.facts li { display: inline-flex; align-items: center; gap: var(--sp-2); }
+.facts li::before { content: ""; width: 0.55rem; height: 0.95rem; margin-top: -0.2rem; border: solid var(--c-brand); border-width: 0 3px 3px 0; transform: rotate(40deg); }
+
+@media (max-width: 30em) {                       /* узкие телефоны: верхняя панель остаётся в одну строку */
+  .brand { font-size: 0.95rem; gap: var(--sp-2); }
+  .toplinks a { padding: 0 var(--sp-3); font-size: 0.875rem; }
+}
+
+/* ───── сцена: так донат выглядит в эфире (меняется вместе с формой) ───── */
+.stage-wrap { margin: var(--sp-6) var(--sp-2) 0 0; }
+.stage { position: relative; container-type: inline-size; aspect-ratio: 16 / 10; overflow: hidden; isolation: isolate;
+  border: 2px solid var(--c-outline); border-radius: var(--r-l); background: #0593C6; box-shadow: var(--hard-md) var(--c-pink); }
+.stage::before { content: ""; position: absolute; z-index: -1; left: -14%; bottom: -46%; width: 78%; aspect-ratio: 1; border-radius: 50%; background: #00769F; }
+.stage::after { content: ""; position: absolute; z-index: -1; right: -12%; bottom: -58%; width: 70%; aspect-ratio: 1; border-radius: 50%; background: #005F84; }
+.stage .sun { position: absolute; z-index: -1; left: 7%; top: 63%; width: 12%; aspect-ratio: 1; border-radius: 50%; background: var(--brand-pink); }
+.stage .live { position: absolute; left: 4%; top: 6%; display: inline-flex; align-items: center; gap: 0.4rem; padding: 0.2rem 0.65rem; border-radius: var(--r-pill);
+  background: var(--brand-pink); color: #0A2F42; font: 700 clamp(0.62rem, 2.6cqw, 0.8rem) var(--font-body); }
+.stage .live::before { content: ""; width: 0.5rem; height: 0.5rem; border-radius: 50%; background: #0A2F42; }
+.stage .cam { position: absolute; right: 4%; top: 6%; width: 21%; aspect-ratio: 4 / 3; border: 2px solid #FCFFFF; border-radius: 12px; background: rgba(7, 28, 40, 0.38); overflow: hidden; }
+.stage .cam::before { content: ""; position: absolute; left: 36%; top: 20%; width: 28%; aspect-ratio: 1; border-radius: 50%; background: rgba(252, 255, 255, 0.85); }
+.stage .cam::after { content: ""; position: absolute; left: 22%; top: 58%; width: 56%; aspect-ratio: 1.6; border-radius: 50% 50% 0 0; background: rgba(252, 255, 255, 0.85); }
+.stage .chat { position: absolute; right: 4%; bottom: 7%; width: 30%; display: grid; gap: 5%; }
+.stage .chat i { display: block; height: clamp(5px, 1.6cqw, 9px); border-radius: 99px; background: rgba(252, 255, 255, 0.6); }
+.stage .chat i:nth-child(2) { width: 72%; }
+.stage .chat i:nth-child(3) { width: 48%; }
+
+.pv { position: absolute; left: 50%; top: 24%; width: min(78%, 27rem); transform: translateX(-50%); padding: 0.85rem 1.1rem; text-align: center;
+  border: 3px solid var(--pv-accent, #0593C6); border-radius: 18px; background: rgba(7, 28, 40, 0.96); color: #FCFFFF;
+  box-shadow: 0 0 0 4px rgba(252, 255, 255, 0.16), 0 14px 30px rgba(0, 0, 0, 0.3); animation: drop 0.9s cubic-bezier(0.3, 1.5, 0.5, 1) 0.5s both; }
+.pv.pop { animation: pop 0.35s ease; }
+.pv-title { font: 800 clamp(0.8rem, 4.4cqw, 1.45rem) / 1.2 var(--font-head); overflow-wrap: anywhere; }
+.pv-msg { margin-top: 0.35rem; font: 400 clamp(0.72rem, 3.1cqw, 1.05rem) / 1.35 var(--font-body); overflow-wrap: anywhere; }
+@keyframes drop { 0% { transform: translate(-50%, -170%) scale(0.85); opacity: 0; } 60% { transform: translate(-50%, 6%) scale(1.02); opacity: 1; } 100% { transform: translate(-50%, 0) scale(1); opacity: 1; } }
+@keyframes pop { 0% { transform: translateX(-50%) scale(1); } 40% { transform: translateX(-50%) scale(1.045); } 100% { transform: translateX(-50%) scale(1); } }
+.stage-cap { margin-top: var(--sp-4); color: var(--c-ink-muted); font-size: var(--fs--1); max-width: 34rem; }
+
+/* ───── карточка и поля ───── */
+.card { position: relative; display: grid; grid-template-columns: minmax(0, 1fr); gap: var(--sp-5); padding: var(--sp-5);
+  background: var(--c-surface); border: 2px solid var(--c-outline); border-radius: var(--r-l); box-shadow: var(--hard-md) var(--c-brand); }
+@media (min-width: 48em) { .card { padding: var(--sp-6); } }
+.card-title { font-size: var(--fs-2); font-weight: 800; }
+.field { display: grid; gap: var(--sp-2); }
+.field > label, legend, .label { font-weight: 700; }
+fieldset { border: 0; margin: 0; padding: 0; min-width: 0; display: grid; gap: var(--sp-2); }
+legend { padding: 0; margin-bottom: var(--sp-2); }
+.input { width: 100%; min-height: 3rem; padding: var(--sp-3) var(--sp-4); border: 2px solid var(--c-outline); border-radius: var(--r-m);
+  background: var(--c-surface); color: var(--c-ink); font: inherit; }
+textarea.input { min-height: 6rem; resize: vertical; }
+.input::placeholder { color: var(--c-ink-muted); opacity: 1; }
+.hint { color: var(--c-ink-muted); font-size: var(--fs--1); display: flex; justify-content: space-between; gap: var(--sp-3); }
+
+.amount { display: flex; align-items: baseline; gap: var(--sp-2); padding: var(--sp-2) var(--sp-4); border: 2px solid var(--c-outline); border-radius: var(--r-m); background: var(--c-surface); }
+.amount:focus-within { outline: 3px solid var(--c-focus); outline-offset: 3px; }
+.amount input { flex: 1; width: 100%; min-width: 0; border: 0; background: transparent; color: var(--c-ink); padding: var(--sp-1) 0; outline: none;
+  font: 800 var(--fs-4) / var(--lh-tight) var(--font-head); }
+.amount span { font: 800 var(--fs-3) / 1 var(--font-head); color: var(--c-link); }
+
+.chips { display: flex; flex-wrap: wrap; gap: var(--sp-2); }
+.chip { min-height: var(--tap); padding: 0 var(--sp-4); border: 2px solid var(--c-outline); border-radius: var(--r-pill); background: var(--c-surface);
+  color: var(--c-ink); font: 700 var(--fs-0) var(--font-body); cursor: pointer; transition: transform 0.08s ease, box-shadow 0.08s ease; }
+.chip:hover { background: var(--c-pink-soft); }
+.chip[aria-pressed="true"] { background: var(--c-pink); transform: translate(-2px, -2px); box-shadow: 3px 3px 0 var(--c-outline); }
+
+/* способы оплаты: настоящие радиокнопки, скрытые визуально, но доступные с клавиатуры и скринридеру */
+.methods { display: grid; gap: var(--sp-3); }
+.method { position: relative; display: block; }
+.method input { position: absolute; width: 1px; height: 1px; margin: 0; opacity: 0; }
+.method .opt { display: grid; grid-template-columns: auto minmax(0, 1fr) auto; align-items: center; gap: var(--sp-3); min-height: 3.75rem;
+  padding: var(--sp-3) var(--sp-4); border: 2px solid var(--c-outline); border-radius: var(--r-m); background: var(--c-surface); cursor: pointer;
+  transition: transform 0.08s ease, box-shadow 0.08s ease; }
+.method .dot { width: 1.25rem; height: 1.25rem; border: 2px solid var(--c-outline); border-radius: 50%; background: var(--c-surface); }
+.method .opt-title { display: block; font-weight: 700; }
+.method .opt-hint { display: block; color: var(--c-ink-muted); font-size: var(--fs--1); }
+.method .opt-icon { width: 1.75rem; height: 1.75rem; color: var(--c-ink); }
+.method:hover .opt { background: var(--c-pink-soft); }
+.method input:checked + .opt { background: var(--c-pink); transform: translate(-2px, -2px); box-shadow: var(--hard-sm); }
+.method input:checked + .opt .opt-hint { color: var(--c-ink); }
+.method input:checked + .opt .dot { background: radial-gradient(circle, var(--c-outline) 0 42%, var(--c-surface) 47%); }
+.method input:focus-visible + .opt { outline: 3px solid var(--c-focus); outline-offset: 3px; }
+
+/* ───── кнопки: нажимаются физически ───── */
+.btn { display: inline-flex; align-items: center; justify-content: center; gap: var(--sp-2); width: 100%; min-height: 3.25rem; padding: 0 var(--sp-5);
+  border: 2px solid var(--c-outline); border-radius: var(--r-m); font: 800 1.125rem var(--font-body); text-decoration: none; text-align: center; cursor: pointer;
+  transition: transform 0.08s ease, box-shadow 0.08s ease, background-color 0.15s ease; }
+.btn-primary { background: var(--c-action); color: var(--c-on-action); box-shadow: 0 5px 0 var(--c-outline); }
+.btn-primary:hover { background: var(--c-action-hover); transform: translateY(-1px); box-shadow: 0 6px 0 var(--c-outline); }
+.btn-primary:active { transform: translateY(5px); box-shadow: 0 0 0 var(--c-outline); }
+.btn:disabled { opacity: 0.55; cursor: not-allowed; transform: none; box-shadow: none; }
+.btn-ghost { width: auto; background: transparent; color: var(--c-link); text-decoration: underline; min-height: var(--tap); font-weight: 700; border-color: transparent; box-shadow: none; }
+
+/* ───── сообщения и состояния ───── */
+.msg { margin: 0; font-size: var(--fs-0); font-weight: 700; }
+.msg:not(:empty) { padding: var(--sp-3) var(--sp-4); border-radius: var(--r-m); border: 2px solid currentColor; }
+/* пустое сообщение об ошибке не занимает места в сетке, но остаётся «живой областью» для скринридера */
+.msg:empty { position: absolute; width: 1px; height: 1px; overflow: hidden; padding: 0; border: 0; }
+#ts:not(.ts-on) { display: none; }
+.msg-error { color: var(--c-error); }
+.msg-error:not(:empty) { background: var(--c-error-bg); }
+.status { display: flex; align-items: center; gap: var(--sp-3); color: var(--c-ink-muted); }
+.spin { width: 1.25rem; height: 1.25rem; flex: none; border: 3px solid var(--c-line); border-top-color: var(--c-link); border-radius: 50%; animation: spin 1s linear infinite; }
+@keyframes spin { to { transform: rotate(360deg); } }
+.stack { display: grid; grid-template-columns: minmax(0, 1fr); gap: var(--sp-4); }
+.lead { margin: 0; color: var(--c-ink-muted); }
+#yk-form { background: #FFFFFF; border-radius: var(--r-m); padding: var(--sp-1); min-height: 7.5rem; }
+.addr { font: 500 0.9375rem / 1.4 ui-monospace, "SF Mono", Consolas, monospace; background: var(--c-surface-soft); border: 2px solid var(--c-outline);
+  border-radius: var(--r-m); padding: var(--sp-3) var(--sp-4); overflow-wrap: anywhere; }
+.big { font: 800 var(--fs-1) / var(--lh-head) var(--font-head); overflow-wrap: anywhere; }
+.qr { display: block; margin-inline: auto; width: 12.5rem; height: 12.5rem; background: #FFFFFF; border: 2px solid var(--c-outline); border-radius: var(--r-m); padding: var(--sp-2); }
+.ts-on { min-height: 4.1rem; }
+.hp { position: absolute; left: -9999px; width: 1px; height: 1px; overflow: hidden; }
+
+.result { text-align: center; justify-items: center; }
+.result h1, .result h2 { font-size: var(--fs-3); font-weight: 800; }
+.result p { color: var(--c-ink-muted); max-width: var(--measure); }
+.tick { width: 5.25rem; height: 5.25rem; }
+.tick circle { fill: var(--c-success-bg); stroke: var(--c-success); stroke-width: 4; stroke-dasharray: 190; stroke-dashoffset: 190; animation: draw 0.7s ease forwards; }
+.tick path { fill: none; stroke: var(--c-success); stroke-width: 5; stroke-linecap: round; stroke-linejoin: round; stroke-dasharray: 50; stroke-dashoffset: 50; animation: draw 0.5s 0.55s ease forwards; }
+@keyframes draw { to { stroke-dashoffset: 0; } }
+.cross { width: 4.5rem; height: 4.5rem; display: grid; place-items: center; border: 2px solid var(--c-error); border-radius: 50%; background: var(--c-error-bg); color: var(--c-error); font: 800 2.5rem / 1 var(--font-head); }
+#confetti { position: fixed; inset: 0; width: 100%; height: 100%; pointer-events: none; z-index: 50; }
+
+/* ───── как это работает (это действительно последовательность) ───── */
+.steps h2, .faq h2 { font-size: var(--fs-3); font-weight: 800; margin-bottom: var(--sp-5); }
+.steps-list { list-style: none; counter-reset: step; margin: 0; padding: 0; display: grid; gap: var(--sp-5); }
+.steps-list li { counter-increment: step; display: grid; gap: var(--sp-1); align-content: start; padding-top: var(--sp-4); border-top: 2px solid var(--c-outline); }
+.steps-list li::before { content: counter(step); font: 800 var(--fs-4) / 1 var(--font-head); color: var(--c-brand); }
+.steps-list strong { font-size: var(--fs-1); }
+.steps-list span { color: var(--c-ink-muted); max-width: 22rem; }
+@media (min-width: 48em) { .steps-list { grid-template-columns: repeat(3, minmax(0, 1fr)); gap: var(--sp-5); } }
+
+/* ───── вопросы и ответы: типографский список, а не набор одинаковых карточек ───── */
+.faq h3 { font-family: var(--font-body); font-size: var(--fs-1); font-weight: 800; letter-spacing: 0; margin-top: var(--sp-5); padding-top: var(--sp-4); border-top: 2px solid var(--c-outline); }
+.faq h3 + p { margin-top: var(--sp-2); max-width: var(--measure); color: var(--c-ink-muted); }
+footer.site { max-width: 75rem; margin: var(--sp-7) auto 0; padding-top: var(--sp-5); border-top: 2px solid var(--c-outline); color: var(--c-ink-muted); font-size: var(--fs--1); }
+.links { list-style: none; display: flex; flex-wrap: wrap; gap: var(--sp-2) var(--sp-5); padding: 0; margin: 0 0 var(--sp-2); }
+.links a { display: inline-flex; align-items: center; min-height: var(--tap); font-weight: 700; font-size: var(--fs-0); }
+
+
+/* ───── вопросы и ответы: поиск и раскрывающиеся пункты (боевая версия) ───── */
+.faq-search { width: 100%; min-height: 3rem; margin: 0 0 var(--sp-3); padding: var(--sp-3) var(--sp-4); border: 2px solid var(--c-outline); border-radius: var(--r-m);
+  background: var(--c-surface); color: var(--c-ink); font: inherit; }
+.faq-empty { margin: 0 0 var(--sp-3); color: var(--c-ink-muted); }
+.faq-list { border-top: 2px solid var(--c-outline); }
+.faq-item { border-bottom: 2px solid var(--c-outline); }
+.faq-item summary { min-height: 3.75rem; display: flex; align-items: center; justify-content: space-between; gap: var(--sp-4); padding: var(--sp-3) var(--sp-1);
+  font-size: var(--fs-1); font-weight: 800; cursor: pointer; list-style: none; }
+.faq-item summary::-webkit-details-marker { display: none; }
+.faq-chevron { flex: none; width: 0.6rem; height: 0.6rem; margin: 0 0.25rem 0.3rem 0; border: solid var(--c-brand); border-width: 0 3px 3px 0; transform: rotate(45deg); transition: transform 0.15s ease; }
+.faq-item[open] .faq-chevron { margin-bottom: -0.2rem; transform: rotate(225deg); }
+.faq-answer p { max-width: var(--measure); margin: 0; padding: 0 var(--sp-5) var(--sp-4) var(--sp-1); color: var(--c-ink-muted); }
+.hero .sub { margin-top: var(--sp-3); font-weight: 700; color: var(--c-ink-muted); }
+
+/* ───── подпись разработчика внизу: «ночной» блок с неоновой ссылкой на Telegram ───── */
+.credits { position: relative; overflow: hidden; isolation: isolate; margin-top: var(--sp-6); padding: var(--sp-5); display: grid; gap: var(--sp-2);
+  background: var(--c-night); color: var(--c-night-ink); border: 2px solid var(--c-outline); border-radius: var(--r-l); box-shadow: var(--hard-md) var(--c-pink); }
+.credits::before { content: ""; position: absolute; inset: 0; z-index: -1; pointer-events: none;
+  background: repeating-linear-gradient(0deg, rgba(122, 211, 241, 0.07) 0 1px, transparent 1px 4px); }
+.credits-label, .credits dt, .credits-copy { font: 700 0.75rem / 1.4 ui-monospace, "SF Mono", Consolas, monospace; letter-spacing: 0.08em; color: var(--c-night-muted); }
+.credits-label { color: var(--c-night-accent); }
+.credits-name { font: 800 var(--fs-3) / var(--lh-head) var(--font-head); color: #FCFFFF; overflow-wrap: anywhere; }
+.credits-role { color: var(--c-night-muted); }
+.credits-contacts { display: grid; gap: var(--sp-4); margin: var(--sp-4) 0 var(--sp-2); }
+@media (min-width: 48em) { .credits-contacts { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
+.credits dd { margin: var(--sp-1) 0 0; }
+.credits a { color: var(--c-night-accent); }
+.credits-mail { display: inline-flex; align-items: center; min-height: var(--tap); font-weight: 700; overflow-wrap: anywhere; }
+.credits a:focus-visible { outline-color: var(--c-night-accent); }
+.cyber { display: inline-flex; align-items: center; gap: 0.6rem; min-height: var(--tap); padding: 0 var(--sp-4); border: 2px solid var(--c-night-accent); border-radius: var(--r-s);
+  background: rgba(122, 211, 241, 0.1); color: var(--c-night-ink); text-decoration: none; font: 700 1rem ui-monospace, "SF Mono", Consolas, monospace;
+  transition: transform 0.08s ease, box-shadow 0.08s ease, background-color 0.15s ease, color 0.15s ease; }
+.cyber-prompt { color: var(--c-night-pink); }
+.cyber-cursor { width: 0.55rem; height: 1.1rem; background: var(--c-night-pink); animation: blink 1.1s steps(2, start) infinite; }
+.cyber:hover, .cyber:focus-visible { background: var(--c-night-accent); color: #04202D; transform: translate(-2px, -2px); box-shadow: 4px 4px 0 var(--c-night-pink); }
+.cyber:hover .cyber-prompt, .cyber:focus-visible .cyber-prompt { color: #04202D; }
+.cyber:hover .cyber-cursor, .cyber:focus-visible .cyber-cursor { background: #04202D; }
+.cyber:hover .cyber-text, .cyber:focus-visible .cyber-text { animation: glitch 0.45s steps(2, end) 1; }
+@keyframes blink { 50% { opacity: 0; } }
+@keyframes glitch {
+  0% { text-shadow: 2px 0 #F8C8DC, -2px 0 #0593C6; transform: translateX(0); }
+  25% { text-shadow: -2px 0 #F8C8DC, 2px 0 #0593C6; transform: translateX(-1px); }
+  50% { text-shadow: 2px 1px #F8C8DC, -2px -1px #0593C6; transform: translateX(1px); }
+  100% { text-shadow: none; transform: translateX(0); }
+}
+
+/* страница «Спасибо» */
+.center-page { min-height: 100vh; display: grid; place-items: center; padding: var(--sp-5); }
+.center-page .card { max-width: 32rem; text-align: center; justify-items: center; }
+
+/* ───── предпочтения пользователя ───── */
+@media (prefers-reduced-motion: reduce) {
+  *, *::before, *::after { animation-duration: 0.01ms !important; animation-delay: 0s !important; animation-iteration-count: 1 !important; transition-duration: 0.01ms !important; scroll-behavior: auto !important; }
+  .tick circle, .tick path { stroke-dashoffset: 0; }
+  .spin { animation: none; border-top-color: var(--c-line); border-style: dotted; }
+  #confetti { display: none; }
+  .cyber-cursor { animation: none; }
+}
+@media (forced-colors: active) {
+  .input, .amount, .chip, .method .opt, .btn, .card, .stage, .credits, .cyber { border: 2px solid ButtonText; }
+  .method input:checked + .opt, .chip[aria-pressed="true"] { outline: 3px solid Highlight; }
+  .method input:focus-visible + .opt { outline: 3px solid Highlight; }
+}
